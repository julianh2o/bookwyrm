// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/// A book in the user's reading list
model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  isbn        String?
  category    String   // 'fiction' or 'nonfiction'
  coverUrl    String?
  notes       String?
  metadataId  String?  // Provider-specific ID (e.g., rreading-glasses workId)
  metadataProvider String? // Provider name (e.g., 'rreading-glasses')
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests    BookRequest[]

  @@index([category])
  @@index([metadataId])
}

/// A request to a specific Readarr instance for a book
model BookRequest {
  id          String   @id @default(cuid())
  bookId      String
  instanceId  String   // References config ID (e.g., 'fiction-audio')
  status      String   @default("pending") // pending, searching, found, downloading, available, not_found, error
  externalId  String?  // Readarr's internal ID for the book (numeric, for API calls)
  externalSlug String? // Readarr's title slug for the book (for web UI URLs)
  errorMessage String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastChecked DateTime?
  phase        String   @default("add") // add, search, download, import, available
  progress     Float?   // 0..1 while downloading
  queueId      Int?     // Readarr queue record id (download/import phases)
  downloadId   String?  // Download client id of the active grab
  outputPath   String?  // Where the download landed (import phase)
  attempts     Int      @default(0)
  lastSearchAt DateTime?
  lastErrorAt  DateTime?

  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  events      RequestEvent[]

  @@unique([bookId, instanceId])
  @@index([status])
  @@index([instanceId])
}

/// History of what happened to a request (shown in the badge hover)
model RequestEvent {
  id        String   @id @default(cuid())
  requestId String
  phase     String
  level     String   // info, warn, error
  message   String
  createdAt DateTime @default(now())

  request   BookRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}
